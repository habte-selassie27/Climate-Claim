# Environment variables for ClimateClaim (frontend + tooling)
#
# Copy this file to `.env` and fill in values for your target network. The
# frontend uses Vite env vars (prefixed `VITE_`). Tooling (scripts/, gltest)
# reads the same names via process.env.
#
# Which network to talk to: `studionet`, `testnetBradbury` or `testnetAsimov`.
# The app defaults to `studionet` (see src/config/network.ts).
VITE_GLTEST_NETWORK=studionet
#
# RPC endpoint for the network (optional override). If omitted the app uses the
# network's default RPC from src/config/network.ts.
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api
#
# Chain ID for the network (optional override). If omitted uses the network's
# chain ID.
VITE_GENLAYER_CHAIN_ID=61999
#
# Three-contract split. Deploy each contract and put its address here. The
# frontend routes methods to the correct contract via src/config/contracts.ts.
VITE_CLIMATECLAIM_ADDRESS=0xE8609cED714D6f9781C93bb387f0943556B87cAA
VITE_CLIMATEPOLICY_ADDRESS=0x358A3ea6018c78F1187d235ac0ACD29696f32cE6
VITE_CLIMATEEVALUATOR_ADDRESS=0x665EeDf75573994C57C53638DaDcA457A61a44E5
#
# Owner/deployer address used for display and for owner-gated actions in the UI.
# The on-chain owner check is the source of truth; this is informational only.
VITE_DEPLOYER_ADDRESS=0x04e0353B7218b66D6803725ce7342E6e1225DB1b
#
# Deployer private key (for local scripts / integration tests). NEVER commit a
# real private key. This repo uses a test key for the documented deployment.
# If you add this to a real deployment, rotate it immediately.
VITE_DEPLOYER_PRIVATE_KEY=
#
# Explorer configuration is hard-coded per network in src/config/network.ts
# (verified explorer URLs and `/tx/` paths). There is no `VITE_EXPLORER_*` knob
# because the explorer facts must not be overridden by env vars.
#
# WalletConnect / EIP-6963 notes: the UI discovers injected wallets via
# EIP-6963 and `window.ethereum`. No project ID is required for basic injected
# wallet connections.
